{
  "name": "steam-account-switcher",
  "version": "2.1.2",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/SunkwiBOT/steam-account-switcher",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "dev:app": "tauri dev",
    "build": "vite build",
    "build:app": "tauri build --no-bundle -- --locked",
    "bundle:linux": "NO_STRIP=true tauri build --bundles appimage,rpm,deb -- --locked",
    "bundle:windows": "tauri build --bundles nsis -- --locked",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./ui/tsconfig.json",
    "lint": "oxlint --deny-warnings ui/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "inlang check --project ./project.inlang --missing-translations --missing-variables --unknown-variables",
    "bindings": "cargo run --quiet -p steam-account-switcher --example export-bindings -- ui/src/lib/bindings && prettier --write ui/src/lib/bindings",
    "bindings:check": "npm run bindings && git status --porcelain -- ui/src/lib/bindings | awk '{ print; exit 1 }'",
    "verify": "npm run format:check && npm run lint && npm run check && npm run i18n:check && npm run bindings:check"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@inlang/cli": "^3.6.0",
    "@inlang/paraglide-js": "^2.29.3",
    "@inlang/plugin-message-format": "^4.6.0",
    "@lucide/svelte": "^1.74.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.5",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-paragraph": "3.34.0",
    "@tiptap/extension-text-style": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@tsconfig/svelte": "^5.0.9",
    "bits-ui": "^2.21.0",
    "clsx": "^2.1.1",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0",
    "vite": "^8.3.8"
  }
}
