{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steam Account Switcher",
  "version": "1.1.0",
  "identifier": "local-account-switcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2NjQxMjk4OTY2NTg0Q0QKUldUTmhHV1dtQkprdG43ZlNyZ2svbEFrZDVFbVdybDFjbWcrajdHUm45OE1LSmsrZ0o3MGVsamYK",
      "endpoints": [
        "https://github.com/SunkwiBOT/steam-account-switcher/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Steam Account Switcher",
        "width": 1180,
        "height": 620,
        "minWidth": 940,
        "minHeight": 460,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["appimage", "rpm", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Switch Steam accounts and track local playtime",
    "longDescription": "Lists the accounts remembered by the local Steam client, switches the auto-login account and restarts Steam. Also tracks local playtime per account, game, session and day without importing Steam profile hours.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "desktopTemplate": "../packaging/steam-account-switcher.desktop"
      },
      "rpm": {
        "epoch": 0,
        "release": "1",
        "desktopTemplate": "../packaging/steam-account-switcher.desktop"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
